<Window x:Class="Monoview.Setup.SetupWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Monoview Setup" Width="620" Height="480" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <!-- Brushes are set in code from the Windows light or dark setting. -->
    <SolidColorBrush x:Key="Bg" Color="#F3F3F3" />
    <SolidColorBrush x:Key="Card" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Text" Color="#1A1A1A" />
    <SolidColorBrush x:Key="SubText" Color="#5C5C5C" />
    <SolidColorBrush x:Key="Line" Color="#E0E0E0" />
    <SolidColorBrush x:Key="Control" Color="#FBFBFB" />
    <SolidColorBrush x:Key="ControlHover" Color="#F0F0F0" />
    <SolidColorBrush x:Key="Accent" Color="#005FB8" />
    <SolidColorBrush x:Key="AccentHover" Color="#1A6FC0" />
    <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF" />
    <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <Style TargetType="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource SubText}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Section" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource Control}" />
      <Setter Property="Foreground" Value="{DynamicResource Text}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="MinWidth" Value="104" />
      <Setter Property="Height" Value="34" />
      <Setter Property="Padding" Value="16,0" />
      <Setter Property="Margin" Value="8,0,0,0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Box" Property="Background" Value="{DynamicResource ControlHover}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{DynamicResource Accent}" />
      <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{DynamicResource AccentHover}" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="LinkButton" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Accent}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <TextBlock x:Name="Label" Text="{TemplateBinding Content}" Background="Transparent" />
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Label" Property="TextDecorations" Value="Underline" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource Text}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Background="Transparent">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
              </Grid.ColumnDefinitions>
              <Border x:Name="Box" Width="20" Height="20" CornerRadius="4" BorderThickness="1" VerticalAlignment="Top"
                      Margin="0,1,0,0" BorderBrush="{DynamicResource SubText}" Background="{DynamicResource Control}">
                <TextBlock x:Name="Check" Text="&#xE73E;" FontFamily="{DynamicResource Icons}" FontSize="12"
                           Foreground="{DynamicResource OnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
              </Border>
              <ContentPresenter Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Top" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Box" Property="Background" Value="{DynamicResource Accent}" />
                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}" />
                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource Text}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Grid Background="Transparent">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
              </Grid.ColumnDefinitions>
              <Grid Width="20" Height="20" VerticalAlignment="Top" Margin="0,1,0,0">
                <Ellipse x:Name="Ring" Stroke="{DynamicResource SubText}" StrokeThickness="1" Fill="{DynamicResource Control}" />
                <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{DynamicResource OnAccent}" Visibility="Collapsed" />
              </Grid>
              <ContentPresenter Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Top" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Ring" Property="Fill" Value="{DynamicResource Accent}" />
                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Accent}" />
                <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="{DynamicResource Text}" />
      <Setter Property="CaretBrush" Value="{DynamicResource Text}" />
      <Setter Property="Height" Value="34" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="Box" Background="{DynamicResource Control}" BorderBrush="{DynamicResource Line}" BorderThickness="1,1,1,2" CornerRadius="5">
              <ScrollViewer x:Name="PART_ContentHost" Margin="8,0" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ProgressBar">
      <Setter Property="Height" Value="4" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid>
              <Border x:Name="PART_Track" CornerRadius="2" Background="{DynamicResource Line}" />
              <Border x:Name="PART_Indicator" CornerRadius="2" Background="{DynamicResource Accent}" HorizontalAlignment="Left" />
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="CardStyle" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Card}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="20,16" />
    </Style>
  </Window.Resources>

  <Grid Margin="32,28,32,24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Header, shared by every page. -->
    <Grid Margin="0,0,0,22">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition />
      </Grid.ColumnDefinitions>
      <Grid Width="56" Height="56" VerticalAlignment="Top">
        <Image x:Name="Logo" Source="Logo.png" RenderOptions.BitmapScalingMode="HighQuality" />
        <Grid x:Name="DoneBadge" Width="56" Height="56" Visibility="Collapsed">
          <Ellipse Fill="{DynamicResource Accent}" />
          <TextBlock Text="&#xE73E;" FontFamily="{DynamicResource Icons}" FontSize="26" Foreground="{DynamicResource OnAccent}"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
      </Grid>
      <StackPanel Grid.Column="1" Margin="18,2,0,0" VerticalAlignment="Center">
        <TextBlock x:Name="Heading" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="26" FontWeight="SemiBold" Text="Install Monoview" />
        <TextBlock x:Name="Subheading" Margin="0,4,0,0" Foreground="{DynamicResource SubText}" Text="A fast, calm PDF viewer for Windows." />
      </StackPanel>
    </Grid>

    <!-- Start: what will happen, with a link to change it. -->
    <StackPanel x:Name="StartPage" Grid.Row="1">
      <Border Style="{StaticResource CardStyle}">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <TextBlock Text="&#xE8B7;" FontFamily="{DynamicResource Icons}" FontSize="18" Foreground="{DynamicResource Accent}" Margin="0,1,14,0" />
            <StackPanel Grid.Column="1">
              <TextBlock x:Name="SummaryScope" Text="Installs just for you. No admin approval needed." />
              <TextBlock x:Name="SummaryFolder" Style="{StaticResource Caption}" Margin="0,2,0,0" />
            </StackPanel>
          </Grid>
          <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <TextBlock Text="&#xE71D;" FontFamily="{DynamicResource Icons}" FontSize="18" Foreground="{DynamicResource Accent}" Margin="0,1,14,0" />
            <TextBlock x:Name="SummaryExtras" Grid.Column="1" />
          </Grid>
        </StackPanel>
      </Border>
      <Button x:Name="OptionsLink" Style="{StaticResource LinkButton}" Content="Change install options" Margin="2,16,0,0"
              HorizontalAlignment="Left" Click="Options_Click" />
    </StackPanel>

    <!-- Options: scope, folder and extras. -->
    <Grid x:Name="OptionsPage" Grid.Row="1" Visibility="Collapsed">
      <Grid.ColumnDefinitions>
        <ColumnDefinition />
        <ColumnDefinition Width="20" />
        <ColumnDefinition />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Style="{StaticResource Section}" Text="Install for" />
        <RadioButton x:Name="JustMe" GroupName="Scope" IsChecked="True" Checked="Scope_Checked">
          <StackPanel>
            <TextBlock Text="Just me" />
            <TextBlock Style="{StaticResource Caption}" Text="No admin approval needed" />
          </StackPanel>
        </RadioButton>
        <RadioButton x:Name="Everyone" GroupName="Scope" Margin="0,12,0,0" Checked="Scope_Checked">
          <StackPanel>
            <TextBlock Text="Everyone on this PC" />
            <TextBlock Style="{StaticResource Caption}" Text="Windows asks for admin approval" />
          </StackPanel>
        </RadioButton>
        <TextBlock Style="{StaticResource Section}" Text="Location" Margin="0,22,0,8" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox x:Name="Folder" />
          <Button Grid.Column="1" MinWidth="0" Width="38" Padding="0" ToolTip="Choose a folder" Click="Browse_Click"
                  AutomationProperties.Name="Choose a folder">
            <TextBlock Text="&#xE8DA;" FontFamily="{DynamicResource Icons}" FontSize="15" />
          </Button>
        </Grid>
      </StackPanel>
      <StackPanel Grid.Column="2">
        <TextBlock Style="{StaticResource Section}" Text="Extras" />
        <CheckBox x:Name="DesktopShortcut">
          <TextBlock Text="Desktop shortcut" />
        </CheckBox>
        <CheckBox x:Name="OpenWith" IsChecked="True" Margin="0,12,0,0">
          <StackPanel>
            <TextBlock Text="Add to Open with for PDF, PNG and JPG" />
            <TextBlock Style="{StaticResource Caption}" Text="Pick Monoview as the default in Windows Settings &gt; Default apps." />
          </StackPanel>
        </CheckBox>
        <CheckBox x:Name="CheckForUpdates" IsChecked="True" Margin="0,12,0,0">
          <StackPanel>
            <TextBlock Text="Check for updates when Monoview starts" />
            <TextBlock Style="{StaticResource Caption}" Text="Monoview asks GitHub if a newer version is out. It sends no personal data." />
          </StackPanel>
        </CheckBox>
      </StackPanel>
    </Grid>

    <!-- Progress. -->
    <StackPanel x:Name="ProgressPage" Grid.Row="1" Visibility="Collapsed" VerticalAlignment="Center" Margin="0,0,0,40">
      <ProgressBar x:Name="Progress" Maximum="100" />
      <TextBlock x:Name="ProgressText" Style="{StaticResource Caption}" Margin="0,10,0,0" Text="Starting…" />
    </StackPanel>

    <!-- A message, for done, maintenance, errors and newer installs. -->
    <StackPanel x:Name="MessagePage" Grid.Row="1" Visibility="Collapsed">
      <TextBlock x:Name="Message" />
      <Button x:Name="LogLink" Style="{StaticResource LinkButton}" Content="Open the setup log" Margin="0,14,0,0"
              HorizontalAlignment="Left" Visibility="Collapsed" Click="Log_Click" />
    </StackPanel>

    <!-- Footer: license note on the left, buttons on the right. -->
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="LicenseNote" Style="{StaticResource Caption}" VerticalAlignment="Center">
        <Run Text="Free and open source under the" />
        <Hyperlink Foreground="{DynamicResource Accent}" Click="License_Click">MIT License</Hyperlink><Run Text="." />
      </TextBlock>
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button x:Name="SecondaryButton" Content="Cancel" Click="Secondary_Click" />
        <Button x:Name="TertiaryButton" Content="Repair" Visibility="Collapsed" Click="Tertiary_Click" />
        <Button x:Name="PrimaryButton" Style="{StaticResource AccentButton}" Click="Primary_Click" IsDefault="True">
          <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="Shield" Text="&#xEA18;" FontFamily="{DynamicResource Icons}" Margin="0,1,8,0" VerticalAlignment="Center" Visibility="Collapsed" />
            <TextBlock x:Name="PrimaryLabel" Text="Install" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
