<Window
    x:Class="Monoview.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Monoview.App"
    Title="Monoview">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <!-- Transparent, not empty: without a background the bare areas (most of the start page) ignore file drops. -->
    <Grid x:Name="Root" Background="Transparent" AllowDrop="True" KeyboardAcceleratorPlacementMode="Hidden" DragOver="Root_DragOver" DragLeave="Root_DragLeave" Drop="Root_Drop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control" Key="O" Invoked="Accel_Open" />
            <KeyboardAccelerator Modifiers="Control" Key="W" Invoked="Accel_CloseTab" />
            <KeyboardAccelerator Modifiers="Control" Key="Tab" Invoked="Accel_NextTab" />
            <KeyboardAccelerator Modifiers="Control,Shift" Key="Tab" Invoked="Accel_PreviousTab" />
            <KeyboardAccelerator Modifiers="Control" Key="F" Invoked="Accel_Find" />
            <KeyboardAccelerator Key="F3" Invoked="Accel_FindNext" />
            <KeyboardAccelerator Modifiers="Shift" Key="F3" Invoked="Accel_FindPrevious" />
            <KeyboardAccelerator Modifiers="Control" Key="B" Invoked="Accel_ToggleSidebar" />
            <KeyboardAccelerator Modifiers="Control" Key="C" Invoked="Accel_Copy" />
            <KeyboardAccelerator Modifiers="Control" Key="A" Invoked="Accel_SelectAll" />
            <KeyboardAccelerator Modifiers="Control" Key="Add" Invoked="Accel_ZoomIn" />
            <KeyboardAccelerator Modifiers="Control" Key="Subtract" Invoked="Accel_ZoomOut" />
            <KeyboardAccelerator Modifiers="Control" Key="Number0" Invoked="Accel_ActualSize" />
            <KeyboardAccelerator Modifiers="Control" Key="Number8" Invoked="Accel_FitWidth" />
            <KeyboardAccelerator Modifiers="Control" Key="Number9" Invoked="Accel_FitPage" />
        </Grid.KeyboardAccelerators>
        <Grid.Resources>
            <ResourceDictionary>
                <!-- Flat, compact toolbar buttons: no fill or border until hovered. -->
                <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Width" Value="36" />
                    <Setter Property="Height" Value="32" />
                    <Setter Property="CornerRadius" Value="4" />
                </Style>
                <Style x:Key="ToolSeparator" TargetType="Rectangle">
                    <Setter Property="Width" Value="1" />
                    <Setter Property="Height" Value="20" />
                    <Setter Property="Margin" Value="6,0" />
                    <Setter Property="Fill" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
                </Style>
            </ResourceDictionary>
        </Grid.Resources>

        <!-- Toolbar first, like Preview; the tab strip below it only appears once a document is open. -->
        <Grid x:Name="Toolbar" Grid.Row="0" Padding="8,6" ColumnSpacing="8">
            <!-- On a home tab the document tools are greyed out: icon only, no fill. -->
            <Grid.Resources>
                <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
                <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />
                <SolidColorBrush x:Key="ToggleButtonBackgroundDisabled" Color="Transparent" />
                <SolidColorBrush x:Key="ToggleButtonBorderBrushDisabled" Color="Transparent" />
                <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedDisabled" Color="Transparent" />
                <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedDisabled" Color="Transparent" />
                <SolidColorBrush x:Key="SplitButtonBackgroundDisabled" Color="Transparent" />
                <SolidColorBrush x:Key="SplitButtonBorderBrushDisabled" Color="Transparent" />
                <SolidColorBrush x:Key="SplitButtonBackgroundCheckedDisabled" Color="Transparent" />
                <SolidColorBrush x:Key="SplitButtonBorderBrushCheckedDisabled" Color="Transparent" />
            </Grid.Resources>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <!-- The markup bar, a second row like Preview's: tools and their style, filled in code. -->
            <StackPanel x:Name="MarkupBar" Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="2" Margin="0,4,0,0" Visibility="Collapsed" />

            <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                <!-- ☰ menu: every command as text, with its shortcut, for when you don't know the icon or the key. -->
                <Button x:Name="MenuButton" Style="{StaticResource ToolButton}"
                        ToolTipService.ToolTip="Menu" AutomationProperties.Name="Menu">
                    <FontIcon Glyph="&#xE700;" FontSize="16" />
                    <Button.Flyout>
                        <MenuFlyout x:Name="MainMenu" Placement="BottomEdgeAlignedLeft" Opening="MainMenu_Opening">
                            <!-- Most-used commands at the top level (like Acrobat's menu); the rest in View/Find/Help. -->
                            <MenuFlyoutItem Text="Open…" Click="Open_Click" KeyboardAcceleratorTextOverride="Ctrl+O">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE838;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="New window" Click="NewWindow_Click" KeyboardAcceleratorTextOverride="Ctrl+N">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A7;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSubItem x:Name="RecentSubMenu" Text="Open recent files">
                                <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE81C;" /></MenuFlyoutSubItem.Icon>
                            </MenuFlyoutSubItem>
                            <MenuFlyoutItem x:Name="SaveItem" Text="Save" Click="Save_Click" KeyboardAcceleratorTextOverride="Ctrl+S">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74E;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="SaveAsItem" Text="Save as…" Click="SaveAs_Click" KeyboardAcceleratorTextOverride="Ctrl+Shift+S" />
                            <MenuFlyoutItem x:Name="ReloadItem" Text="Reload" Click="Reload_Click" KeyboardAcceleratorTextOverride="F5">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE72C;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="CloseTabItem" Text="Close tab" Click="CloseTab_Click" KeyboardAcceleratorTextOverride="Ctrl+W" />
                            <MenuFlyoutItem x:Name="CloseAllItem" Text="Close all tabs" Click="CloseAll_Click" KeyboardAcceleratorTextOverride="Ctrl+Shift+W" />
                            <MenuFlyoutSeparator />

                            <MenuFlyoutItem x:Name="PrintItem" Text="Print…" Click="Print_Click" KeyboardAcceleratorTextOverride="Ctrl+P">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE749;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSubItem x:Name="FindMenu" Text="Find">
                                <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE721;" /></MenuFlyoutSubItem.Icon>
                                <MenuFlyoutItem Text="Find…" Click="Find_Click" KeyboardAcceleratorTextOverride="Ctrl+F" />
                                <MenuFlyoutItem Text="Find next" Click="NextHit_Click" KeyboardAcceleratorTextOverride="F3" />
                                <MenuFlyoutItem Text="Find previous" Click="PrevHit_Click" KeyboardAcceleratorTextOverride="Shift+F3" />
                            </MenuFlyoutSubItem>
                            <MenuFlyoutSeparator />

                            <MenuFlyoutItem x:Name="UndoItem" Text="Undo" Click="Undo_Click" KeyboardAcceleratorTextOverride="Ctrl+Z">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7A7;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="RedoItem" Text="Redo" Click="Redo_Click" KeyboardAcceleratorTextOverride="Ctrl+Y">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7A6;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="CopyItem" Text="Copy" Click="Copy_Click" KeyboardAcceleratorTextOverride="Ctrl+C">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="SelectAllItem" Text="Select all" Click="SelectAll_Click" KeyboardAcceleratorTextOverride="Ctrl+A" />
                            <MenuFlyoutSeparator />

                            <MenuFlyoutSubItem x:Name="PagesMenu" Text="Pages">
                                <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE7C3;" /></MenuFlyoutSubItem.Icon>
                                <ToggleMenuFlyoutItem x:Name="EditPagesMenuItem" Text="Edit pages in the sidebar" Click="EditPagesMenu_Click" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="Rotate left" Tag="RotateLeft" Click="PagesMenu_Click" />
                                <MenuFlyoutItem Text="Rotate right" Tag="RotateRight" Click="PagesMenu_Click" />
                                <MenuFlyoutItem Text="Delete" Tag="Delete" Click="PagesMenu_Click" />
                                <MenuFlyoutItem Text="Copy pages" Tag="Copy" Click="PagesMenu_Click" />
                                <MenuFlyoutItem Text="Paste pages after" Tag="Paste" Click="PagesMenu_Click" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="Insert pages from file…" Tag="InsertFromFile" Click="PagesMenu_Click" />
                                <MenuFlyoutItem Text="Extract pages to a new PDF…" Tag="Extract" Click="PagesMenu_Click" />
                                <MenuFlyoutItem Text="Export pages as pictures…" Tag="ExportImages" Click="PagesMenu_Click" />
                            </MenuFlyoutSubItem>
                            <MenuFlyoutSubItem x:Name="ViewMenu" Text="View">
                                <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE890;" /></MenuFlyoutSubItem.Icon>
                                <MenuFlyoutItem x:Name="SidebarItem" Text="Hide sidebar" Click="SidebarButton_Click" KeyboardAcceleratorTextOverride="Ctrl+B" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="Zoom in" Click="ZoomIn_Click" KeyboardAcceleratorTextOverride="Ctrl++">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A3;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Zoom out" Click="ZoomOut_Click" KeyboardAcceleratorTextOverride="Ctrl+-">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE71F;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Actual size" Click="ActualSize_Click" KeyboardAcceleratorTextOverride="Ctrl+0" />
                                <MenuFlyoutItem Text="Fit width" Click="FitWidth_Click" KeyboardAcceleratorTextOverride="Ctrl+8" />
                                <MenuFlyoutItem Text="Fit page" Click="FitPage_Click" KeyboardAcceleratorTextOverride="Ctrl+9" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="Rotate clockwise" Click="RotateRight_Click" KeyboardAcceleratorTextOverride="Ctrl+R">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7AD;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Rotate counter-clockwise" Click="RotateLeft_Click" KeyboardAcceleratorTextOverride="Ctrl+L" />
                                <ToggleMenuFlyoutItem x:Name="SinglePageItem" Text="Single page" Click="SinglePage_Click" />
                                <ToggleMenuFlyoutItem x:Name="TwoPageItem" Text="Two-page view" Click="TwoPage_Click" />
                                <ToggleMenuFlyoutItem x:Name="FullScreenItem" Text="Full screen" Click="FullScreen_Click" KeyboardAcceleratorTextOverride="F11" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="Go to page…" Click="GoToPage_Click" KeyboardAcceleratorTextOverride="Ctrl+G" />
                                <MenuFlyoutItem x:Name="BackItem" Text="Back" Click="Back_Click" KeyboardAcceleratorTextOverride="Alt+Left">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE72B;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Name="ForwardItem" Text="Forward" Click="Forward_Click" KeyboardAcceleratorTextOverride="Alt+Right">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE72A;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Next tab" Click="NextTab_Click" KeyboardAcceleratorTextOverride="Ctrl+Tab" />
                                <MenuFlyoutItem Text="Previous tab" Click="PreviousTab_Click" KeyboardAcceleratorTextOverride="Ctrl+Shift+Tab" />
                            </MenuFlyoutSubItem>
                            <MenuFlyoutSeparator />

                            <MenuFlyoutItem x:Name="ShowInExplorerItem" Text="Show in File Explorer" Click="ShowInExplorer_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xEC50;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="CopyPathItem" Text="Copy file path" Click="CopyPath_Click" />
                            <MenuFlyoutItem x:Name="PropertiesItem" Text="Document properties…" Click="Properties_Click" KeyboardAcceleratorTextOverride="Ctrl+D">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE946;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />

                            <MenuFlyoutItem Text="Settings…" Click="Settings_Click" KeyboardAcceleratorTextOverride="Ctrl+,">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE713;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="RegisterButton" Text="Add Monoview to “Open with”…" Click="Register_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7AC;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="UnregisterButton" Text="Remove Monoview from “Open with”" Click="Unregister_Click" />
                            <MenuFlyoutSubItem Text="Help">
                                <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE897;" /></MenuFlyoutSubItem.Icon>
                                <MenuFlyoutItem Text="Keyboard shortcuts" Click="Shortcuts_Click" KeyboardAcceleratorTextOverride="F1">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE765;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="About Monoview" Click="About_Click" />
                            </MenuFlyoutSubItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Exit" Click="Exit_Click" KeyboardAcceleratorTextOverride="Ctrl+Q" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <Button x:Name="SidebarButton" Style="{StaticResource ToolButton}" Click="SidebarButton_Click"
                        ToolTipService.ToolTip="Show or hide sidebar (Ctrl+B)" AutomationProperties.Name="Sidebar">
                    <!-- Panel icon like Claude's: rounded window outline with the sidebar divider on the left. -->
                    <Grid Width="16" Height="14">
                        <Rectangle x:Name="SidebarIconFrame" RadiusX="3" RadiusY="3" StrokeThickness="1.25" />
                        <Rectangle x:Name="SidebarIconDivider" Width="1.25" HorizontalAlignment="Left" Margin="5,0,0,0" />
                    </Grid>
                </Button>
                <Rectangle x:Name="SidebarSeparator" Style="{StaticResource ToolSeparator}" />
                <Button Style="{StaticResource ToolButton}" Click="Open_Click"
                        ToolTipService.ToolTip="Open (Ctrl+O)" AutomationProperties.Name="Open">
                    <FontIcon Glyph="&#xE838;" FontSize="16" />
                </Button>
                <Button Style="{StaticResource ToolButton}" ToolTipService.ToolTip="Recent files" AutomationProperties.Name="Recent files">
                    <FontIcon Glyph="&#xE81C;" FontSize="16" />
                    <Button.Flyout>
                        <MenuFlyout x:Name="RecentMenu" Placement="BottomEdgeAlignedLeft" Opening="RecentMenu_Opening" />
                    </Button.Flyout>
                </Button>

                <StackPanel x:Name="DocTools" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                    <Button Style="{StaticResource ToolButton}" Click="Print_Click"
                            ToolTipService.ToolTip="Print (Ctrl+P)" AutomationProperties.Name="Print">
                        <FontIcon Glyph="&#xE749;" FontSize="16" />
                    </Button>
                    <Rectangle Style="{StaticResource ToolSeparator}" />
                    <Button Style="{StaticResource ToolButton}" Click="ZoomOut_Click"
                            ToolTipService.ToolTip="Zoom out (Ctrl+-)" AutomationProperties.Name="Zoom out">
                        <FontIcon Glyph="&#xE71F;" FontSize="16" />
                    </Button>
                    <DropDownButton Height="32" MinWidth="76" Padding="8,0" Background="Transparent" BorderThickness="0"
                                    CornerRadius="4" ToolTipService.ToolTip="Zoom" AutomationProperties.Name="Zoom">
                        <TextBlock x:Name="ZoomLabel" Text="100%" />
                        <DropDownButton.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                <MenuFlyoutItem Text="Fit width" Click="FitWidth_Click" KeyboardAcceleratorTextOverride="Ctrl+8" />
                                <MenuFlyoutItem Text="Fit page" Click="FitPage_Click" KeyboardAcceleratorTextOverride="Ctrl+9" />
                                <MenuFlyoutItem Text="Actual size" Click="ActualSize_Click" KeyboardAcceleratorTextOverride="Ctrl+0" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="50%" Tag="0.5" Click="ZoomPreset_Click" />
                                <MenuFlyoutItem Text="100%" Tag="1" Click="ZoomPreset_Click" />
                                <MenuFlyoutItem Text="150%" Tag="1.5" Click="ZoomPreset_Click" />
                                <MenuFlyoutItem Text="200%" Tag="2" Click="ZoomPreset_Click" />
                                <MenuFlyoutItem Text="400%" Tag="4" Click="ZoomPreset_Click" />
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                    <Button Style="{StaticResource ToolButton}" Click="ZoomIn_Click"
                            ToolTipService.ToolTip="Zoom in (Ctrl++)" AutomationProperties.Name="Zoom in">
                        <FontIcon Glyph="&#xE8A3;" FontSize="16" />
                    </Button>
                    <Rectangle Style="{StaticResource ToolSeparator}" />
                    <!-- Highlight, underline, strikethrough: a click marks the selection, or with none turns that marking mode on.
                         The highlighter's arrow picks the color all three use. -->
                    <ToggleSplitButton x:Name="HighlightButton" Height="32" Padding="6,0" Background="Transparent" BorderThickness="0"
                                       CornerRadius="4" IsCheckedChanged="HighlightButton_IsCheckedChanged"
                                       ToolTipService.ToolTip="Highlight (Ctrl+H). With no text selected, turns highlighting on or off."
                                       AutomationProperties.Name="Highlight">
                        <Grid Width="18" Height="20">
                            <FontIcon Glyph="&#xE7E6;" FontSize="16" VerticalAlignment="Top" />
                            <Rectangle x:Name="HighlightSwatch" Height="3" VerticalAlignment="Bottom" RadiusX="1" RadiusY="1" Fill="#FFE600" />
                        </Grid>
                        <ToggleSplitButton.Flyout>
                            <Flyout x:Name="HighlightMenu" Placement="BottomEdgeAlignedLeft" Opening="HighlightMenu_Opening" />
                        </ToggleSplitButton.Flyout>
                    </ToggleSplitButton>
                    <ToggleButton x:Name="UnderlineButton" Height="32" Width="32" Padding="0" Background="Transparent" BorderThickness="0"
                                  CornerRadius="4" Click="UnderlineButton_Click"
                                  ToolTipService.ToolTip="Underline. With no text selected, turns underlining on or off."
                                  AutomationProperties.Name="Underline">
                        <Grid Width="16" Height="20">
                            <TextBlock Text="U" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Top" />
                            <Rectangle x:Name="UnderlineSwatch" Height="2" VerticalAlignment="Bottom" Margin="0,0,0,1" Fill="#FFE600" />
                        </Grid>
                    </ToggleButton>
                    <ToggleButton x:Name="StrikeButton" Height="32" Width="32" Padding="0" Background="Transparent" BorderThickness="0"
                                  CornerRadius="4" Click="StrikeButton_Click"
                                  ToolTipService.ToolTip="Strikethrough. With no text selected, turns striking through on or off."
                                  AutomationProperties.Name="Strikethrough">
                        <Grid Width="16" Height="20">
                            <TextBlock Text="S" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Rectangle x:Name="StrikeSwatch" Height="2" VerticalAlignment="Center" Margin="0,1,0,0" Fill="#FFE600" />
                        </Grid>
                    </ToggleButton>
                    <!-- Sign: pick a saved signature and click the page to place it, or make a new one. -->
                    <DropDownButton x:Name="SignButton" Height="32" Padding="6,0" Background="Transparent" BorderThickness="0" CornerRadius="4"
                                    ToolTipService.ToolTip="Sign: place a saved signature, or make a new one" AutomationProperties.Name="Sign">
                        <FontIcon Glyph="&#xEDFB;" FontSize="16" />
                        <DropDownButton.Flyout>
                            <Flyout x:Name="SignMenu" Placement="BottomEdgeAlignedLeft" Opening="SignMenu_Opening" />
                        </DropDownButton.Flyout>
                    </DropDownButton>
                    <ToggleButton x:Name="MarkupToggle" Height="32" Width="36" Padding="0" Background="Transparent" BorderThickness="0"
                                  CornerRadius="4" Click="MarkupToggle_Click"
                                  ToolTipService.ToolTip="Markup tools: draw, shapes, text boxes and notes (Ctrl+Shift+A)" AutomationProperties.Name="Markup tools">
                        <!-- A pen over a square: drawing and shapes, unlike the highlighter's marker. -->
                        <Path x:Name="MarkupIcon" Data="M2,6 L2,16 L12,16 L12,12 M6,12 L16,2 L18,4 L8,14 L5,15 Z"
                              StrokeThickness="1.4" StrokeLineJoin="Round" Width="20" Height="18" />
                    </ToggleButton>
                    <Rectangle Style="{StaticResource ToolSeparator}" />
                    <TextBox x:Name="PageBox" Width="48" MinWidth="48" Height="32" TextAlignment="Center" VerticalAlignment="Center"
                             AutomationProperties.Name="Page number"
                             KeyDown="PageBox_KeyDown" LostFocus="PageBox_LostFocus" GotFocus="PageBox_GotFocus" />
                    <TextBlock x:Name="PageCountLabel" VerticalAlignment="Center" Margin="6,0,0,0" Opacity="0.7" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                <StackPanel x:Name="SearchTools" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                    <TextBox x:Name="SearchBox" Width="220" Height="32" PlaceholderText="Search (Ctrl+F)"
                             AutomationProperties.Name="Search"
                             KeyDown="SearchBox_KeyDown" TextChanged="SearchBox_TextChanged" />
                    <Button Style="{StaticResource ToolButton}" ToolTipService.ToolTip="Search options" AutomationProperties.Name="Search options">
                        <TextBlock Text="Aa" FontSize="13" />
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight" Opening="SearchOptions_Opening">
                                <ToggleMenuFlyoutItem x:Name="MatchCaseItem" Text="Match case" Click="SearchOption_Click" />
                                <ToggleMenuFlyoutItem x:Name="WholeWordItem" Text="Whole words only" Click="SearchOption_Click" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <TextBlock x:Name="SearchCount" VerticalAlignment="Center" MinWidth="48" TextAlignment="Center"
                               Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}" Visibility="Collapsed" />
                    <Button x:Name="PrevHitButton" Style="{StaticResource ToolButton}" Click="PrevHit_Click" Visibility="Collapsed"
                            ToolTipService.ToolTip="Previous match (Shift+F3)" AutomationProperties.Name="Previous match">
                        <FontIcon Glyph="&#xE70E;" FontSize="12" />
                    </Button>
                    <Button x:Name="NextHitButton" Style="{StaticResource ToolButton}" Click="NextHit_Click" Visibility="Collapsed"
                            ToolTipService.ToolTip="Next match (F3)" AutomationProperties.Name="Next match">
                        <FontIcon Glyph="&#xE70D;" FontSize="12" />
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>

        <TabView x:Name="Tabs" Grid.Row="1" VerticalAlignment="Top" Visibility="Collapsed"
                 TabWidthMode="SizeToContent" CanReorderTabs="False" CanDragTabs="False" AllowDropTabs="False"
                 AddTabButtonClick="Tabs_AddTabButtonClick"
                 TabCloseRequested="Tabs_TabCloseRequested"
                 SelectionChanged="Tabs_SelectionChanged">
            <!-- Tabs float as pills over the toolbar's ground, like the cards below, so none has to join the page.
                 The selected tab takes TabViewItemHeaderBackground; its flared shape is hidden. MakePill does the rest. -->
            <TabView.Resources>
                <StaticResource x:Key="TabViewItemHeaderBackground" ResourceKey="PanelSurfaceBrush" />
                <SolidColorBrush x:Key="TabViewItemHeaderBackgroundSelected" Color="Transparent" />
                <SolidColorBrush x:Key="TabViewItemSeparator" Color="Transparent" />
                <Thickness x:Key="TabViewSelectedItemHeaderMargin">0,4,0,4</Thickness>
                <SolidColorBrush x:Key="TabViewBorderBrush" Color="Transparent" />
                <SolidColorBrush x:Key="TabViewSelectedItemBorderBrush" Color="Transparent" />
            </TabView.Resources>
        </TabView>

        <!-- Collapsed while closed, or its margin leaves a gap under the tabs. -->
        <InfoBar x:Name="ErrorBar" Grid.Row="2" Severity="Error" IsOpen="False" Margin="12,0,12,8"
                 Visibility="{x:Bind ErrorBar.IsOpen, Mode=OneWay}" />

        <!-- Sidebar, page view and home page are cards with a gutter of the toolbar's ground around them. -->
        <Grid x:Name="DocumentHost" Grid.Row="3" Margin="8">
            <!-- The start page, also shown in a new tab. With no recent files it is the centered first-run page. -->
            <ScrollViewer x:Name="StartPage" Visibility="Collapsed" Background="{ThemeResource PanelSurfaceBrush}" CornerRadius="10">
                <Grid x:Name="StartArea">
                    <StackPanel x:Name="StartContent" MaxWidth="920" Margin="24,40" Spacing="28">
                        <StackPanel x:Name="HeroHeader" HorizontalAlignment="Center" Spacing="8">
                            <Image Source="ms-appx:///Assets/Package/Square44x44Logo.targetsize-256_altform-unplated.png" Width="88" Height="88" />
                            <TextBlock Text="Monoview" Style="{StaticResource TitleLargeTextBlockStyle}" HorizontalAlignment="Center" />
                            <TextBlock Text="Read, mark up and sign PDFs and pictures." HorizontalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel x:Name="CompactHeader" Orientation="Horizontal" Spacing="16">
                            <Image Source="ms-appx:///Assets/Package/Square44x44Logo.targetsize-256_altform-unplated.png" Width="56" Height="56" />
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Monoview" Style="{StaticResource TitleTextBlockStyle}" />
                                <TextBlock Text="Read, mark up and sign PDFs and pictures." Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- The whole window takes drops; this shows it, and lights up while a file is dragged over. -->
                        <Grid Height="184">
                            <Rectangle x:Name="DropOutline" RadiusX="12" RadiusY="12" StrokeThickness="1.5" StrokeDashArray="4,3"
                                       Stroke="{ThemeResource ControlStrongStrokeColorDefaultBrush}" Fill="{ThemeResource SubtleFillColorSecondaryBrush}" />
                            <Border x:Name="DropHighlight" Visibility="Collapsed" CornerRadius="12" BorderThickness="2"
                                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}">
                                <Border Background="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0.1" CornerRadius="10" />
                            </Border>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
                                <Path Data="M10,4 H24 L32,12 V36 H10 Z M24,4 V12 H32 M21,18 V29 M16.5,24.5 L21,29 L25.5,24.5" Width="40" Height="40"
                                      HorizontalAlignment="Center" StrokeThickness="1.5" StrokeLineJoin="Round"
                                      Stroke="{ThemeResource TextFillColorSecondaryBrush}" />
                                <StackPanel Spacing="2">
                                    <TextBlock x:Name="DropTitle" Text="Drop a PDF, PNG or JPG here" HorizontalAlignment="Center"
                                               Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="16" />
                                    <TextBlock Text="or anywhere in this window" HorizontalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <StackPanel x:Name="DropButtons" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                    <Button Style="{StaticResource AccentButtonStyle}" Click="Open_Click" Padding="16,8">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE838;" FontSize="16" />
                                            <TextBlock Text="Open file…" />
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Text="Ctrl+O" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <StackPanel x:Name="RecentSection" Spacing="8">
                            <Grid>
                                <TextBlock Text="Recent" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <HyperlinkButton Content="Clear list" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                 Click="ClearRecent_Click" ToolTipService.ToolTip="Clear the recent files list" />
                            </Grid>
                            <GridView x:Name="RecentList" IsItemClickEnabled="True" SelectionMode="None" ItemClick="RecentList_ItemClick"
                                      ContainerContentChanging="RecentList_ContainerContentChanging">
                                <GridView.ItemTemplate>
                                    <DataTemplate x:DataType="local:RecentEntry">
                                        <Grid Width="218" Height="168" CornerRadius="8" BorderThickness="1" ToolTipService.ToolTip="{x:Bind Path}"
                                              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="108" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <!-- The top of the first page, filled in once rendered; the icon shows until then or if it can't be. -->
                                            <Grid Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                                <FontIcon x:Name="ThumbIcon" Glyph="&#xE8A5;" FontSize="32" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                <Image x:Name="Thumb" Width="104" Height="96" Stretch="Uniform" VerticalAlignment="Bottom" />
                                            </Grid>
                                            <StackPanel Grid.Row="1" Padding="12,8" Spacing="2" VerticalAlignment="Center">
                                                <Grid ColumnSpacing="6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Background="{x:Bind Badge}" CornerRadius="3" Padding="4,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind Kind}" FontSize="10" FontWeight="Bold" Foreground="Black" />
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                                <TextBlock Text="{x:Bind Folder}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </GridView.ItemTemplate>
                            </GridView>
                        </StackPanel>

                        <!-- First run only: what Monoview does, and how to make it open PDFs. -->
                        <StackPanel x:Name="FirstRunSection" Spacing="20">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Padding="14" Spacing="6" CornerRadius="8" BorderThickness="1"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                    <FontIcon Glyph="&#xE70F;" FontSize="20" HorizontalAlignment="Left" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Text="Mark up" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="Highlight, underline, draw shapes, add notes." TextWrapping="Wrap"
                                               Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Padding="14" Spacing="6" CornerRadius="8" BorderThickness="1"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                    <FontIcon Glyph="&#xEDFB;" FontSize="20" HorizontalAlignment="Left" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Text="Sign" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="Save a signature once, place it anywhere." TextWrapping="Wrap"
                                               Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Padding="14" Spacing="6" CornerRadius="8" BorderThickness="1"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                    <FontIcon Glyph="&#xE7C3;" FontSize="20" HorizontalAlignment="Left" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Text="Edit pages" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="Rotate, delete, insert and extract pages." TextWrapping="Wrap"
                                               Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Grid>
                            <StackPanel x:Name="OpenWithHint" Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="Want PDFs to open here?" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <HyperlinkButton Content="Add Monoview to “Open with”" Click="Register_Click" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock HorizontalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="Ctrl+O  Open     Ctrl+T  New tab     Ctrl+Shift+T  Reopen closed tab     F1  All shortcuts" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>




