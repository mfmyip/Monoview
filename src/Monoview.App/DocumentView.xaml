<UserControl
    x:Class="Monoview.App.DocumentView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Monoview.App"
    xmlns:engine="using:Monoview.Engine">

    <UserControl.Resources>
        <!-- One step darker than SolidBackgroundFillColorSecondary, so the page area stands apart from the sidebar. -->
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="ViewerBackgroundBrush" Color="#E6E6E6" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="ViewerBackgroundBrush" Color="#161616" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="220" MinWidth="0" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid x:Name="Sidebar" Background="{ThemeResource PanelSurfaceBrush}" CornerRadius="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <SelectorBar x:Name="SidebarTabs" HorizontalAlignment="Center" SelectionChanged="SidebarTabs_SelectionChanged">
                <SelectorBarItem x:Name="ThumbnailsTab" Text="Pages" IsSelected="True" />
                <SelectorBarItem x:Name="OutlineTab" Text="Outline" />
                <SelectorBarItem x:Name="SearchTab" Text="Search" />
            </SelectorBar>

            <!-- Pages. Read-only until "Edit pages" is on, so a stray drag or Delete can't change the document.
                 When editing: Ctrl/Shift-click to select several, drag to reorder or onto another document's pages to move them there,
                 Delete, Ctrl+C and Ctrl+V to copy pages, drop a PDF to insert. -->
            <Grid x:Name="PagesPanel" Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!-- Outlined, not filled, so it reads as a control on the card; on, it fills with the accent. -->
                <ToggleButton x:Name="EditPagesButton" HorizontalAlignment="Stretch" Margin="8,4,8,4"
                              Click="EditPagesButton_Click"
                              ToolTipService.ToolTip="Turn on to reorder, delete, rotate or insert pages">
                    <ToggleButton.Resources>
                        <SolidColorBrush x:Key="ToggleButtonBackground" Color="Transparent" />
                        <StaticResource x:Key="ToggleButtonBorderBrush" ResourceKey="PanelStrokeBrush" />
                        <StaticResource x:Key="ToggleButtonBorderBrushPointerOver" ResourceKey="PanelStrokeBrush" />
                    </ToggleButton.Resources>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon x:Name="EditPagesIcon" Glyph="&#xE70F;" FontSize="14" />
                        <TextBlock x:Name="EditPagesLabel" Text="Edit pages" />
                    </StackPanel>
                </ToggleButton>
            <ListView x:Name="Thumbnails" Grid.Row="1" SelectionMode="Single"
                      CanDragItems="False" CanReorderItems="False" AllowDrop="True"
                      SelectionChanged="Thumbnails_SelectionChanged"
                      ContainerContentChanging="Thumbnails_ContainerContentChanging"
                      DragItemsStarting="Thumbnails_DragItemsStarting" DragItemsCompleted="Thumbnails_DragItemsCompleted"
                      DragOver="Thumbnails_DragOver" DragLeave="Thumbnails_DragLeave" Drop="Thumbnails_Drop"
                      KeyDown="Thumbnails_KeyDown" ContextRequested="Thumbnails_ContextRequested">
                <!-- The selected page shows as a ring around its picture, not a filled row with a bar. -->
                <ListView.Resources>
                    <x:Boolean x:Key="ListViewItemSelectionIndicatorVisualEnabled">False</x:Boolean>
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="Transparent" />
                    <StaticResource x:Key="ListViewItemBackgroundSelectedPointerOver" ResourceKey="ListViewItemBackgroundPointerOver" />
                    <StaticResource x:Key="ListViewItemBackgroundSelectedPressed" ResourceKey="ListViewItemBackgroundPressed" />
                </ListView.Resources>
                <ListView.ContextFlyout>
                    <MenuFlyout x:Name="PageMenu" Opening="PageMenu_Opening">
                        <ToggleMenuFlyoutItem x:Name="EditPagesMenuItem" Text="Edit pages" Click="EditPagesMenuItem_Click" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Rotate left" Tag="RotateLeft" Click="PageMenu_Click">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7AD;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Rotate right" Tag="RotateRight" Click="PageMenu_Click" />
                        <MenuFlyoutItem Text="Delete" Tag="Delete" Click="PageMenu_Click" KeyboardAcceleratorTextOverride="Delete">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Copy" Tag="Copy" Click="PageMenu_Click" KeyboardAcceleratorTextOverride="Ctrl+C">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Paste after" Tag="Paste" Click="PageMenu_Click" KeyboardAcceleratorTextOverride="Ctrl+V">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE77F;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Insert pages from file…" Tag="InsertFromFile" Click="PageMenu_Click">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8E5;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Extract pages to a new PDF…" Tag="Extract" Click="PageMenu_Click" />
                        <MenuFlyoutItem Text="Export pages as pictures…" Tag="ExportImages" Click="PageMenu_Click" />
                    </MenuFlyout>
                </ListView.ContextFlyout>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:ThumbnailItem">
                        <StackPanel Padding="0,8" HorizontalAlignment="Center">
                            <Border BorderBrush="{x:Bind Ring, Mode=OneWay}" BorderThickness="2" CornerRadius="5" Padding="2">
                                <Border Width="{x:Bind DisplayWidth}" Height="{x:Bind DisplayHeight}" CornerRadius="2"
                                        Background="White" BorderBrush="#30000000" BorderThickness="1">
                                    <Image Source="{x:Bind Image, Mode=OneWay}" Stretch="Uniform" />
                                </Border>
                            </Border>
                            <TextBlock Text="{x:Bind Label}" HorizontalAlignment="Center" Margin="0,4,0,0"
                                       Style="{StaticResource CaptionTextBlockStyle}" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>
            </Grid>

            <Grid x:Name="OutlinePanel" Grid.Row="1" x:Load="False">
                <TreeView x:Name="Outline" ItemInvoked="Outline_ItemInvoked" SelectionMode="None">
                    <TreeView.ItemTemplate>
                        <DataTemplate x:DataType="engine:OutlineItem">
                            <TreeViewItem ItemsSource="{x:Bind Children}" Content="{x:Bind Title}"
                                          ToolTipService.ToolTip="{x:Bind Title}" />
                        </DataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
                <TextBlock x:Name="NoOutline" Text="This document has no outline." Margin="16"
                           TextWrapping="Wrap" Opacity="0.6" Visibility="Collapsed" />
            </Grid>

            <Grid x:Name="SearchPanel" Grid.Row="1" x:Load="False">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="SearchStatus" Margin="16,8" Opacity="0.7"
                           Style="{StaticResource CaptionTextBlockStyle}" Text="Press Ctrl+F to search." />
                <ListView x:Name="SearchResults" Grid.Row="1" SelectionMode="Single" IsItemClickEnabled="True"
                          ItemClick="SearchResults_ItemClick">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:SearchResultItem">
                            <StackPanel Padding="0,6">
                                <TextBlock Text="{x:Bind PageLabel}" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                                <TextBlock TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis">
                                    <Run Text="{x:Bind Before}" /><Run Text="{x:Bind Match}" FontWeight="SemiBold" /><Run Text="{x:Bind After}" />
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>

        <!-- Rounded top-left corner, so the page area meets the tab line softly. -->
        <!-- A card beside the sidebar card, with a gutter between that the splitter sits in. -->
        <Border x:Name="ViewerHost" Grid.Column="1" CornerRadius="10" Margin="8,0,0,0" Background="{ThemeResource ViewerBackgroundBrush}" />

        <!-- The page selector over the page area's bottom-right corner, clear of the scroll bar: previous, the page
             box (type a number and press Enter, or Ctrl+G), the count, next. Dark in both themes so it reads over any page. -->
        <Border Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,16"
                Padding="2" CornerRadius="8" Background="#262626" RequestedTheme="Dark">
            <StackPanel Orientation="Horizontal" Spacing="2">
                <Button Width="28" Height="28" Padding="0" Background="Transparent" BorderThickness="0" Click="PreviousPage_Click"
                        ToolTipService.ToolTip="Previous page" AutomationProperties.Name="Previous page">
                    <FontIcon Glyph="&#xE76B;" FontSize="12" />
                </Button>
                <TextBox x:Name="PageBox" Width="44" MinWidth="44" Height="28" MinHeight="28" Padding="4,4,4,0" TextAlignment="Center"
                         VerticalAlignment="Center" AutomationProperties.Name="Page number"
                         KeyDown="PageBox_KeyDown" LostFocus="PageBox_LostFocus" GotFocus="PageBox_GotFocus" />
                <TextBlock x:Name="PageCount" VerticalAlignment="Center" Margin="4,0,2,0" FontSize="13" Opacity="0.8" />
                <Button Width="28" Height="28" Padding="0" Background="Transparent" BorderThickness="0" Click="NextPage_Click"
                        ToolTipService.ToolTip="Next page" AutomationProperties.Name="Next page">
                    <FontIcon Glyph="&#xE76C;" FontSize="12" />
                </Button>
            </StackPanel>
        </Border>

        <!-- Drag handle on the sidebar's right edge: drag to resize; the width is remembered. -->
        <Border x:Name="SidebarSplitter" Grid.Column="1" Width="6" Margin="1,0,0,0"
                HorizontalAlignment="Left" Background="Transparent"
                PointerEntered="SidebarSplitter_PointerEntered" PointerExited="SidebarSplitter_PointerExited"
                PointerPressed="SidebarSplitter_PointerPressed" PointerMoved="SidebarSplitter_PointerMoved"
                PointerReleased="SidebarSplitter_PointerReleased" PointerCaptureLost="SidebarSplitter_PointerCaptureLost"
                AutomationProperties.Name="Resize sidebar" />

    </Grid>
</UserControl>

