<Window
    x:Class="CleanPDF.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CleanPDF.App"
    Title="CleanPDF">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root" AllowDrop="True" DragOver="Root_DragOver" Drop="Root_Drop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control" Key="O" Invoked="Accel_Open" />
            <KeyboardAccelerator Modifiers="Control" Key="W" Invoked="Accel_CloseTab" />
            <KeyboardAccelerator Modifiers="Control" Key="Tab" Invoked="Accel_NextTab" />
            <KeyboardAccelerator Modifiers="Control,Shift" Key="Tab" Invoked="Accel_PreviousTab" />
            <KeyboardAccelerator Modifiers="Control" Key="F" Invoked="Accel_Find" />
            <KeyboardAccelerator Key="F3" Invoked="Accel_FindNext" />
            <KeyboardAccelerator Modifiers="Shift" Key="F3" Invoked="Accel_FindPrevious" />
            <KeyboardAccelerator Modifiers="Control" Key="B" Invoked="Accel_ToggleSidebar" />
            <KeyboardAccelerator Modifiers="Control" Key="C" Invoked="Accel_Copy" />
            <KeyboardAccelerator Modifiers="Control" Key="A" Invoked="Accel_SelectAll" />
            <KeyboardAccelerator Modifiers="Control" Key="Add" Invoked="Accel_ZoomIn" />
            <KeyboardAccelerator Modifiers="Control" Key="Subtract" Invoked="Accel_ZoomOut" />
            <KeyboardAccelerator Modifiers="Control" Key="Number0" Invoked="Accel_ActualSize" />
            <KeyboardAccelerator Modifiers="Control" Key="Number8" Invoked="Accel_FitWidth" />
            <KeyboardAccelerator Modifiers="Control" Key="Number9" Invoked="Accel_FitPage" />
        </Grid.KeyboardAccelerators>
        <TabView x:Name="Tabs" Grid.Row="0" VerticalAlignment="Top"
                 TabWidthMode="SizeToContent" CanReorderTabs="True" CanDragTabs="False"
                 AddTabButtonClick="Tabs_AddTabButtonClick"
                 TabCloseRequested="Tabs_TabCloseRequested"
                 SelectionChanged="Tabs_SelectionChanged">
        </TabView>

        <Grid x:Name="Toolbar" Grid.Row="1" Padding="4,0,12,0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <CommandBar DefaultLabelPosition="Collapsed" HorizontalAlignment="Left" Background="Transparent"
                        IsDynamicOverflowEnabled="True">
                <AppBarToggleButton x:Name="SidebarButton" Label="Sidebar" ToolTipService.ToolTip="Sidebar (Ctrl+B)"
                                    Click="SidebarButton_Click" IsChecked="True">
                    <AppBarToggleButton.Icon>
                        <FontIcon Glyph="&#xE89F;" />
                    </AppBarToggleButton.Icon>
                </AppBarToggleButton>
                <AppBarButton Icon="OpenFile" Label="Open" ToolTipService.ToolTip="Open (Ctrl+O)" Click="Open_Click" />
                <AppBarButton x:Name="RecentButton" Label="Recent" ToolTipService.ToolTip="Recent files">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE81C;" />
                    </AppBarButton.Icon>
                    <AppBarButton.Flyout>
                        <MenuFlyout x:Name="RecentMenu" Opening="RecentMenu_Opening" />
                    </AppBarButton.Flyout>
                </AppBarButton>
                <AppBarSeparator />
                <AppBarButton x:Name="ZoomOutButton" Icon="ZoomOut" Label="Zoom out" ToolTipService.ToolTip="Zoom out (Ctrl+-)" Click="ZoomOut_Click" />
                <AppBarButton x:Name="ZoomButton" Label="Zoom" ToolTipService.ToolTip="Zoom options" Width="76">
                    <AppBarButton.Content>
                        <TextBlock x:Name="ZoomLabel" Text="100%" HorizontalAlignment="Center" />
                    </AppBarButton.Content>
                    <AppBarButton.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="Fit width" Click="FitWidth_Click" KeyboardAcceleratorTextOverride="Ctrl+8" />
                            <MenuFlyoutItem Text="Fit page" Click="FitPage_Click" KeyboardAcceleratorTextOverride="Ctrl+9" />
                            <MenuFlyoutItem Text="Actual size" Click="ActualSize_Click" KeyboardAcceleratorTextOverride="Ctrl+0" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="50%" Tag="0.5" Click="ZoomPreset_Click" />
                            <MenuFlyoutItem Text="100%" Tag="1" Click="ZoomPreset_Click" />
                            <MenuFlyoutItem Text="150%" Tag="1.5" Click="ZoomPreset_Click" />
                            <MenuFlyoutItem Text="200%" Tag="2" Click="ZoomPreset_Click" />
                            <MenuFlyoutItem Text="400%" Tag="4" Click="ZoomPreset_Click" />
                        </MenuFlyout>
                    </AppBarButton.Flyout>
                </AppBarButton>
                <AppBarButton x:Name="ZoomInButton" Icon="ZoomIn" Label="Zoom in" ToolTipService.ToolTip="Zoom in (Ctrl++)" Click="ZoomIn_Click" />
                <AppBarSeparator />
                <AppBarElementContainer VerticalContentAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="4,0">
                        <TextBox x:Name="PageBox" Width="56" MinWidth="56" TextAlignment="Center"
                                 KeyDown="PageBox_KeyDown" LostFocus="PageBox_LostFocus" GotFocus="PageBox_GotFocus" />
                        <TextBlock x:Name="PageCountLabel" VerticalAlignment="Center" Opacity="0.8" />
                    </StackPanel>
                </AppBarElementContainer>

                <CommandBar.SecondaryCommands>
                    <AppBarButton x:Name="RegisterButton" Label="Add CleanPDF to â€œOpen withâ€â€¦" Click="Register_Click">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE7AC;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton x:Name="UnregisterButton" Label="Remove CleanPDF from â€œOpen withâ€" Click="Unregister_Click" />
                </CommandBar.SecondaryCommands>
            </CommandBar>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <TextBox x:Name="SearchBox" Width="240" PlaceholderText="Search (Ctrl+F)"
                         KeyDown="SearchBox_KeyDown" TextChanged="SearchBox_TextChanged" />
                <TextBlock x:Name="SearchCount" VerticalAlignment="Center" MinWidth="56" TextAlignment="Center"
                           Opacity="0.8" Style="{StaticResource CaptionTextBlockStyle}" />
                <Button x:Name="PrevHitButton" ToolTipService.ToolTip="Previous match (Shift+F3)" Click="PrevHit_Click"
                        Background="Transparent" BorderThickness="0" Padding="8">
                    <FontIcon Glyph="&#xE70E;" FontSize="12" />
                </Button>
                <Button x:Name="NextHitButton" ToolTipService.ToolTip="Next match (F3)" Click="NextHit_Click"
                        Background="Transparent" BorderThickness="0" Padding="8">
                    <FontIcon Glyph="&#xE70D;" FontSize="12" />
                </Button>
            </StackPanel>
        </Grid>

        <InfoBar x:Name="ErrorBar" x:Load="False" Grid.Row="2" Severity="Error" IsOpen="False" Margin="12,0,12,8" />

        <Grid x:Name="DocumentHost" Grid.Row="3" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <ScrollViewer x:Name="StartPage" x:Load="False">
                <StackPanel MaxWidth="560" Margin="24,64" Spacing="16">
                    <TextBlock Text="CleanPDF" Style="{StaticResource TitleLargeTextBlockStyle}" />
                    <TextBlock Text="Open a PDF, or drop one anywhere on this window." Opacity="0.7" />
                    <Button Style="{StaticResource AccentButtonStyle}" Click="Open_Click" Padding="16,8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <SymbolIcon Symbol="OpenFile" />
                            <TextBlock Text="Open PDFâ€¦" />
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="RecentHeader" Text="Recent" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,24,0,0" />
                    <ListView x:Name="RecentList" IsItemClickEnabled="True" SelectionMode="None" ItemClick="RecentList_ItemClick">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:RecentEntry">
                                <StackPanel Padding="0,6">
                                    <TextBlock Text="{x:Bind Name}" />
                                    <TextBlock Text="{x:Bind Folder}" Opacity="0.6" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>



