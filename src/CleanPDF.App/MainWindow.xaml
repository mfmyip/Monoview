<Window
    x:Class="CleanPDF.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CleanPDF.App"
    Title="CleanPDF">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root" AllowDrop="True" KeyboardAcceleratorPlacementMode="Hidden" DragOver="Root_DragOver" Drop="Root_Drop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control" Key="O" Invoked="Accel_Open" />
            <KeyboardAccelerator Modifiers="Control" Key="W" Invoked="Accel_CloseTab" />
            <KeyboardAccelerator Modifiers="Control" Key="Tab" Invoked="Accel_NextTab" />
            <KeyboardAccelerator Modifiers="Control,Shift" Key="Tab" Invoked="Accel_PreviousTab" />
            <KeyboardAccelerator Modifiers="Control" Key="F" Invoked="Accel_Find" />
            <KeyboardAccelerator Key="F3" Invoked="Accel_FindNext" />
            <KeyboardAccelerator Modifiers="Shift" Key="F3" Invoked="Accel_FindPrevious" />
            <KeyboardAccelerator Modifiers="Control" Key="B" Invoked="Accel_ToggleSidebar" />
            <KeyboardAccelerator Modifiers="Control" Key="C" Invoked="Accel_Copy" />
            <KeyboardAccelerator Modifiers="Control" Key="A" Invoked="Accel_SelectAll" />
            <KeyboardAccelerator Modifiers="Control" Key="Add" Invoked="Accel_ZoomIn" />
            <KeyboardAccelerator Modifiers="Control" Key="Subtract" Invoked="Accel_ZoomOut" />
            <KeyboardAccelerator Modifiers="Control" Key="Number0" Invoked="Accel_ActualSize" />
            <KeyboardAccelerator Modifiers="Control" Key="Number8" Invoked="Accel_FitWidth" />
            <KeyboardAccelerator Modifiers="Control" Key="Number9" Invoked="Accel_FitPage" />
        </Grid.KeyboardAccelerators>
        <Grid.Resources>
            <!-- Flat, compact toolbar buttons: no fill or border until hovered. -->
            <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="32" />
                <Setter Property="CornerRadius" Value="4" />
            </Style>
            <Style x:Key="ToolSeparator" TargetType="Rectangle">
                <Setter Property="Width" Value="1" />
                <Setter Property="Height" Value="20" />
                <Setter Property="Margin" Value="6,0" />
                <Setter Property="Fill" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
            </Style>
        </Grid.Resources>

        <!-- Toolbar first, like Preview; the tab strip below it only appears once a document is open. -->
        <Grid x:Name="Toolbar" Grid.Row="0" Padding="8,6" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                <Button Style="{StaticResource ToolButton}" Click="Open_Click"
                        ToolTipService.ToolTip="Open (Ctrl+O)" AutomationProperties.Name="Open">
                    <FontIcon Glyph="&#xE8E5;" FontSize="16" />
                </Button>
                <Button Style="{StaticResource ToolButton}" ToolTipService.ToolTip="Recent files" AutomationProperties.Name="Recent files">
                    <FontIcon Glyph="&#xE81C;" FontSize="16" />
                    <Button.Flyout>
                        <MenuFlyout x:Name="RecentMenu" Placement="BottomEdgeAlignedLeft" Opening="RecentMenu_Opening" />
                    </Button.Flyout>
                </Button>

                <StackPanel x:Name="DocTools" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                    <Rectangle Style="{StaticResource ToolSeparator}" />
                    <Button Style="{StaticResource ToolButton}" Click="ZoomOut_Click"
                            ToolTipService.ToolTip="Zoom out (Ctrl+-)" AutomationProperties.Name="Zoom out">
                        <FontIcon Glyph="&#xE71F;" FontSize="16" />
                    </Button>
                    <DropDownButton Height="32" MinWidth="76" Padding="8,0" Background="Transparent" BorderThickness="0"
                                    CornerRadius="4" ToolTipService.ToolTip="Zoom" AutomationProperties.Name="Zoom">
                        <TextBlock x:Name="ZoomLabel" Text="100%" />
                        <DropDownButton.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                <MenuFlyoutItem Text="Fit width" Click="FitWidth_Click" KeyboardAcceleratorTextOverride="Ctrl+8" />
                                <MenuFlyoutItem Text="Fit page" Click="FitPage_Click" KeyboardAcceleratorTextOverride="Ctrl+9" />
                                <MenuFlyoutItem Text="Actual size" Click="ActualSize_Click" KeyboardAcceleratorTextOverride="Ctrl+0" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="50%" Tag="0.5" Click="ZoomPreset_Click" />
                                <MenuFlyoutItem Text="100%" Tag="1" Click="ZoomPreset_Click" />
                                <MenuFlyoutItem Text="150%" Tag="1.5" Click="ZoomPreset_Click" />
                                <MenuFlyoutItem Text="200%" Tag="2" Click="ZoomPreset_Click" />
                                <MenuFlyoutItem Text="400%" Tag="4" Click="ZoomPreset_Click" />
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                    <Button Style="{StaticResource ToolButton}" Click="ZoomIn_Click"
                            ToolTipService.ToolTip="Zoom in (Ctrl++)" AutomationProperties.Name="Zoom in">
                        <FontIcon Glyph="&#xE8A3;" FontSize="16" />
                    </Button>
                    <Rectangle Style="{StaticResource ToolSeparator}" />
                    <TextBox x:Name="PageBox" Width="48" MinWidth="48" Height="32" TextAlignment="Center" VerticalAlignment="Center"
                             AutomationProperties.Name="Page number"
                             KeyDown="PageBox_KeyDown" LostFocus="PageBox_LostFocus" GotFocus="PageBox_GotFocus" />
                    <TextBlock x:Name="PageCountLabel" VerticalAlignment="Center" Margin="6,0,0,0" Opacity="0.7" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                <StackPanel x:Name="SearchTools" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                    <TextBox x:Name="SearchBox" Width="220" Height="32" PlaceholderText="Search (Ctrl+F)"
                             AutomationProperties.Name="Search"
                             KeyDown="SearchBox_KeyDown" TextChanged="SearchBox_TextChanged" />
                    <TextBlock x:Name="SearchCount" VerticalAlignment="Center" MinWidth="48" TextAlignment="Center"
                               Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}" />
                    <Button Style="{StaticResource ToolButton}" Click="PrevHit_Click"
                            ToolTipService.ToolTip="Previous match (Shift+F3)" AutomationProperties.Name="Previous match">
                        <FontIcon Glyph="&#xE70E;" FontSize="12" />
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Click="NextHit_Click"
                            ToolTipService.ToolTip="Next match (F3)" AutomationProperties.Name="Next match">
                        <FontIcon Glyph="&#xE70D;" FontSize="12" />
                    </Button>
                </StackPanel>
                <Button Style="{StaticResource ToolButton}" ToolTipService.ToolTip="More" AutomationProperties.Name="More">
                    <FontIcon Glyph="&#xE712;" FontSize="16" />
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuFlyoutItem x:Name="RegisterButton" Text="Add CleanPDF to “Open with”…" Click="Register_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE7AC;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="UnregisterButton" Text="Remove CleanPDF from “Open with”" Click="Unregister_Click" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>

        <TabView x:Name="Tabs" Grid.Row="1" VerticalAlignment="Top" Visibility="Collapsed"
                 TabWidthMode="SizeToContent" CanReorderTabs="True" CanDragTabs="False"
                 AddTabButtonClick="Tabs_AddTabButtonClick"
                 TabCloseRequested="Tabs_TabCloseRequested"
                 SelectionChanged="Tabs_SelectionChanged">
        </TabView>

        <InfoBar x:Name="ErrorBar" Grid.Row="2" Severity="Error" IsOpen="False" Margin="12,0,12,8" />

        <Grid x:Name="DocumentHost" Grid.Row="3" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <ScrollViewer x:Name="StartPage" Visibility="Collapsed">
                <StackPanel MaxWidth="560" Margin="24,64" Spacing="16">
                    <TextBlock Text="CleanPDF" Style="{StaticResource TitleLargeTextBlockStyle}" />
                    <TextBlock Text="Open a PDF, or drop one anywhere on this window." Opacity="0.7" />
                    <Button Style="{StaticResource AccentButtonStyle}" Click="Open_Click" Padding="16,8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <SymbolIcon Symbol="OpenFile" />
                            <TextBlock Text="Open PDF…" />
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="RecentHeader" Text="Recent" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,24,0,0" />
                    <ListView x:Name="RecentList" IsItemClickEnabled="True" SelectionMode="None" ItemClick="RecentList_ItemClick">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:RecentEntry">
                                <StackPanel Padding="0,6">
                                    <TextBlock Text="{x:Bind Name}" />
                                    <TextBlock Text="{x:Bind Folder}" Opacity="0.6" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>




